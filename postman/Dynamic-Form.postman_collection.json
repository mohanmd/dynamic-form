{
  "info": {
    "name": "Dynamic Form API",
    "description": "All endpoints of the Dynamic Form. Run top-to-bottom: Login stores {{token}}, Create Form stores {{formId}}, Create Submission stores {{submissionId}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "adminEmail",
      "value": "admin@example.com"
    },
    {
      "key": "adminPassword",
      "value": "ChangeMe@123"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "formId",
      "value": ""
    },
    {
      "key": "submissionId",
      "value": ""
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "url": "{{baseUrl}}/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (wrong password)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"wrong\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('returns token', () => pm.expect(body.data.token).to.be.a('string'));",
                  "pm.collectionVariables.set('token', body.data.token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Forms (admin)",
      "item": [
        {
          "name": "List forms - no token (401)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": "{{baseUrl}}/forms"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401 without token', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create form - invalid definition (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/forms",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Broken\",\n  \"fields\": [\n    { \"key\": \"gender\", \"label\": \"Gender\", \"type\": \"select\" },\n    { \"key\": \"a\", \"label\": \"A\", \"type\": \"text\" },\n    { \"key\": \"a\", \"label\": \"A again\", \"type\": \"text\" }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('has field errors', () => pm.expect(pm.response.json().errors).to.be.an('object'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create form",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/forms",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Customer Registration\",\n  \"fields\": [\n    { \"key\": \"firstName\", \"label\": \"First Name\", \"type\": \"text\", \"required\": true, \"validation\": { \"minLength\": 2, \"maxLength\": 50 } },\n    { \"key\": \"email\", \"label\": \"Email\", \"type\": \"email\", \"required\": true },\n    { \"key\": \"mobile\", \"label\": \"Mobile\", \"type\": \"phone\" },\n    { \"key\": \"age\", \"label\": \"Age\", \"type\": \"number\", \"validation\": { \"min\": 18, \"max\": 99 } },\n    { \"key\": \"gender\", \"label\": \"Gender\", \"type\": \"select\", \"required\": true, \"options\": [\"Male\", \"Female\", \"Other\"] },\n    { \"key\": \"interests\", \"label\": \"Interests\", \"type\": \"checkbox\", \"options\": [\"Sports\", \"Music\", \"Tech\"] },\n    { \"key\": \"dob\", \"label\": \"Date of Birth\", \"type\": \"date\" }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('starts as draft', () => pm.expect(body.data.status).to.eql('draft'));",
                  "pm.collectionVariables.set('formId', body.data._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List forms (paginated)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/forms?page=1&limit=10"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('has meta', () => pm.expect(pm.response.json().meta).to.have.keys('page','limit','total','totalPages'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get form - public, while draft (404)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": "{{baseUrl}}/forms/{{formId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('draft hidden from public', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get form (admin)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/forms/{{formId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update form",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/forms/{{formId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Customer Registration (updated)\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('name updated', () => pm.expect(pm.response.json().data.name).to.include('updated'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Publish form",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/forms/{{formId}}/publish"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('published', () => pm.expect(pm.response.json().data.status).to.eql('published'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get form - public (published)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": "{{baseUrl}}/forms/{{formId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('has fields', () => pm.expect(pm.response.json().data.fields.length).to.be.above(0));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Submissions",
      "item": [
        {
          "name": "Submit - invalid data (400)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/forms/{{formId}}/submissions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"firstName\": \"\",\n    \"email\": \"not-an-email\",\n    \"mobile\": \"12ab\",\n    \"age\": 10,\n    \"gender\": \"Robot\",\n    \"interests\": [\"Cooking\"],\n    \"dob\": \"2024-02-31\"\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "const errors = pm.response.json().errors;",
                  "pm.test('every invalid field reported', () => pm.expect(errors).to.have.all.keys('firstName','email','mobile','age','gender','interests','dob'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Submit - valid",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/forms/{{formId}}/submissions",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"firstName\": \"Mohan\",\n    \"email\": \"mohan@example.com\",\n    \"mobile\": \"+91 98765 43210\",\n    \"age\": 28,\n    \"gender\": \"Male\",\n    \"interests\": [\"Tech\", \"Music\"],\n    \"dob\": \"1997-05-14\",\n    \"$where\": \"this should be dropped\"\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('submissionId', pm.response.json().data._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List submissions (page mode)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/forms/{{formId}}/submissions?page=1&limit=10"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('total >= 1', () => pm.expect(pm.response.json().meta.total).to.be.at.least(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get submission",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/submissions/{{submissionId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('unknown keys stripped', () => pm.expect(pm.response.json().data.data).to.not.have.property('$where'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete submission",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/submissions/{{submissionId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Cleanup",
      "item": [
        {
          "name": "Delete form",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/forms/{{formId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
